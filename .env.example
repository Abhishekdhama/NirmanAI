# NirmanAI — optional integrations
#
# The dashboard, the models, the simulator and the API all run WITHOUT any of
# these. Each key only switches on an extra capability, and every one of them
# degrades to a clearly-labelled fallback when absent.

# Conversational layer for the Jarvis assistant.
# Without it, Jarvis still works — it routes directly to the simulator,
# optimiser, supplier database and report generator.
GEMINI_API_KEY=

# Live weather for the delivery-risk and report weather sections.
# Without it, NirmanAI uses the IMD-calibrated seasonal monsoon profile and
# labels it as such on screen.
OPENWEATHERMAP_API_KEY=

# API key clients must send as the X-API-Key header to api.py.
# Defaults to the demo key when unset.
NIRMANAI_API_KEY=nirmanai-demo-key-2026
